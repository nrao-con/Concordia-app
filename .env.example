# ConcordiaCare – Environment Variable Reference
#
# Copy this file to .env and fill in the values for your deployment.
# Variables marked [REQUIRED] must be set before the server will start correctly.
# Variables marked [OPTIONAL] have working defaults and only need to be set to
# override the default behaviour.
#
# After changing any variable, restart (or redeploy) the server for the new
# value to take effect.

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# SESSION & AUTH
# ---------------------------------------------------------------------------

# [REQUIRED] Secret used to sign session cookies. Use a long random string.
SESSION_SECRET=

# [REQUIRED] Replit Auth issuer URL (set automatically on Replit).
ISSUER_URL=

# [OPTIONAL] Replit Repl ID (set automatically on Replit).
REPL_ID=

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------

# [OPTIONAL] Port the Express server listens on. Default: 5000
PORT=5000

# [OPTIONAL] Node environment. Set to "production" for live deployments.
# Default: development
NODE_ENV=development

# ---------------------------------------------------------------------------
# OPENAI / AI INTEGRATION
# ---------------------------------------------------------------------------

# [REQUIRED for AI features] OpenAI API key provided by Replit AI Integrations.
AI_INTEGRATIONS_OPENAI_API_KEY=

# [OPTIONAL] Custom OpenAI-compatible base URL (Replit AI sets this automatically).
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# PUSH NOTIFICATIONS (Web Push / VAPID)
# ---------------------------------------------------------------------------

# [REQUIRED for push notifications] VAPID public key.
VAPID_PUBLIC_KEY=

# [REQUIRED for push notifications] VAPID private key.
VAPID_PRIVATE_KEY=

# [REQUIRED for push notifications] Email address included in the VAPID header.
# Must be prefixed with "mailto:".
# Example: mailto:admin@example.com
VAPID_EMAIL=

# ---------------------------------------------------------------------------
# PHARMACY ALERT NOTIFICATION SETTINGS
#
# These variables let operators tune how pharmacy alert push notifications
# behave without touching source code.  All take effect after a server restart.
# ---------------------------------------------------------------------------

# [OPTIONAL] Vibration pattern for pharmacy alert push notifications.
# Comma-separated list of durations in milliseconds, alternating
# vibrate / pause / vibrate / … (same format as the Web Vibration API).
#
# Rules:
#   - Between 1 and 20 values
#   - Each value must be between 0 and 10 000 ms
#   - If the value is missing or malformed, the default is used
#
# Default: 300,100,300,100,300,100,300  (three short bursts)
PHARMACY_ALERT_VIBRATE_PATTERN=300,100,300,100,300,100,300

# [OPTIONAL] Whether pharmacy alert notifications stay on screen until the
# user explicitly dismisses them (requireInteraction behaviour).
#
# Set to "false" to let the OS auto-dismiss the notification.
# Any value other than "false" (including absent) is treated as "true".
#
# Default: true
PHARMACY_ALERT_REQUIRE_INTERACTION=true

# ---------------------------------------------------------------------------
# NOTIFICATION RETENTION
#
# These variables control how long notification records are kept in the
# database before they are purged.  Purging runs at startup and then on a
# repeating schedule so old rows do not accumulate indefinitely.
# ---------------------------------------------------------------------------

# [OPTIONAL] How many DAYS pharmacy alert notifications are kept before being
# deleted from the database.
#
# Valid range: any integer >= 1
# If the value is missing, zero, negative, or non-numeric, the default is used.
#
# Default: 7  (one week)
PHARMACY_ALERT_RETENTION_DAYS=7

# [OPTIONAL] How many HOURS non-pharmacy notifications (reminders, order
# updates, etc.) are kept before being deleted from the database.
#
# Valid range: any integer >= 1
# If the value is missing, zero, negative, or non-numeric, the default is used.
#
# Default: 24  (one day)
NOTIFICATION_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ---------------------------------------------------------------------------

# [REQUIRED] API key used to authenticate requests to/from the Concordia RX
# website (concordianyc.com).  Must match the key configured on the website.
CONCORDIA_API_KEY=

# [REQUIRED] Base URL of the Concordia RX website API.
# Example: https://concordianyc.com
CONCORDIA_API_URL=

# [OPTIONAL] API key for the PharmFlow pharmacy integration hub.
PHARMFLOW_API_KEY=

# [OPTIONAL] Base URL for the PharmFlow API.
# Example: https://api.pharmflow.com
PHARMFLOW_API_URL=

# [OPTIONAL] API key that grants access to staff/operator-only endpoints
# (e.g. the sync dashboard).
STAFF_API_KEY=
CONCORDIA_STAFF_WEBHOOK_KEY=

# [OPTIONAL] Origin URL of the staff/operator web app, used for CORS.
# Example: https://staff.concordianyc.com
STAFF_APP_URL=
